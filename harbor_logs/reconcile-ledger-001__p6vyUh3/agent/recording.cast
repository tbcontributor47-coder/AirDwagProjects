[87.900839, "i", "python3 << 'EOF'\nimport json\nimport random\n\n# Generate 10,000 transactions\ntransactions = []\nfor i in range(10000):\n    transactions.append({\n        \"id\": f\"tx{i}\",\n        \"account_id\": f\"ACC{i % 100}\",\n        \"amount\": str(round(random.uniform(-1000, 1000), 2)),\n        \"currency\": random.choice([\"USD\", \"EUR\", \"GBP\", \"JPY\"]),\n        \"timestamp\": f\"2024-01-{(i % 28) + 1:02d}T{(i % 24):02d}:00:00Z\"\n    })\n\nledger = {\n    \"exchange_rates\": {\"EUR\": 1.18, \"GBP\": 1.38, \"JPY\": 0.0091},\n    \"transactions\": transactions\n}\n\nwith open('/tmp/test_large.json', 'w') as f:\n    json.dump(ledger, f)\n    \nprint(\"Generated 10,000 transactions\")\nEOF\n"]
